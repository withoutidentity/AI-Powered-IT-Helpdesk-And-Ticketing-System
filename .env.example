# Database
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=helpdesk
ConnectionStrings__Default=Host=localhost;Port=5433;Database=helpdesk;Username=helpdesk;Password=changeme

# pgAdmin (local development only)
PGADMIN_DEFAULT_EMAIL=admin@helpdesk.dev
PGADMIN_DEFAULT_PASSWORD=changeme

# Frontend / CORS
Cors__AllowedOrigins__0=http://localhost:4200

# Auth
Jwt__Secret=changeme-use-a-long-random-value
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# AI
Groq__ApiKey=changeme
Groq__ChatModel=llama-3.3-70b-versatile
Groq__EmbeddingModel=nomic-embed-text-v1_5

# Notifications
Discord__WebhookUrl=changeme
